# Copy this file to `.env` and fill in your real values.
# `.env` is git-ignored and must never be committed.

# Supabase (https://supabase.com) — Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Google Maps / Places / Directions API key (Google Cloud Console).
# NOTE: The Android native map ALSO needs this key in
# android/app/src/main/AndroidManifest.xml (com.google.android.geo.API_KEY).
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Open Charge Map API key — free, register at https://openchargemap.org/site/loginprovider/beginlogin
OPEN_CHARGE_MAP_API_KEY=YOUR_OPEN_CHARGE_MAP_API_KEY

# Mapbox public access token (for the upcoming custom map layer) — https://account.mapbox.com
MAPBOX_ACCESS_TOKEN=YOUR_MAPBOX_ACCESS_TOKEN
