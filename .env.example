# Copy this file to `.env` and fill in your real values.
# `.env` is git-ignored and must never be committed.

# Supabase (https://supabase.com) — Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Google Maps / Places / Directions API key (Google Cloud Console).
# NOTE: The Android native map ALSO needs this key in
# android/app/src/main/AndroidManifest.xml (com.google.android.geo.API_KEY).
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Open Charge Map API key — free, register at https://openchargemap.org/site/loginprovider/beginlogin
OPEN_CHARGE_MAP_API_KEY=YOUR_OPEN_CHARGE_MAP_API_KEY

# Mapbox public access token (for the upcoming custom map layer) — https://account.mapbox.com
MAPBOX_ACCESS_TOKEN=YOUR_MAPBOX_ACCESS_TOKEN

# Google Sign-In (Google Cloud Console > Credentials > OAuth 2.0 client IDs)
# Web client ID is used as the Supabase "server client ID" on all platforms.
# iOS client ID is only needed for the iOS build.
GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
